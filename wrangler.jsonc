{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maintainer-sim",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "not_found_handling": "none",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAMES",
        "class_name": "GameSession",
      },
      {
        "name": "BUDGET",
        "class_name": "AIBudget",
      },
      {
        "name": "LAUNCHES",
        "class_name": "LaunchSession",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameSession", "AIBudget"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LaunchSession"],
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "SCENARIO_REPOSITORIES": "rkkautsar/forum-scenario,rkkautsar/group-chat-scenario",
    "JUDGE_ENABLED": "true",
    "REVIEW_COACHING_ENABLED": "true",
    "COACH_CONFIDENCE_THRESHOLD": "0.3",
    "JUDGE_CONFIDENCE_THRESHOLD": "0.2",
    "JUDGE_INPUT_USD_PER_MILLION": "0.038",
    "AI_DAILY_BUDGET_USD": "1",
    "GITHUB_CLIENT_ID": "Iv23liIU7hVd8ynBoZN4",
    "GITHUB_APP_SLUG": "pr-flood",
    "PUBLIC_ORIGIN": "https://pr-flood.lol",
  },
  "observability": {
    "enabled": true,
  },
}
